{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocationStoryIntent",
  "type": "object",
  "required": [
    "projectName",
    "rawIntent",
    "subject",
    "storyGoals"
  ],
  "properties": {
    "projectName": {
      "type": "string",
      "minLength": 1
    },
    "rawIntent": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "placeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "provenance": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "storyGoals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "requestedCategories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}