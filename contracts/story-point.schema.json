{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoryPoint",
  "type": "object",
  "required": [
    "id",
    "label",
    "category",
    "symbol",
    "longitude",
    "latitude",
    "coordinateSource",
    "visible"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "coordinateSource": {
      "enum": [
        "geocoder",
        "map_click",
        "import"
      ]
    },
    "providerPlaceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "visible": {
      "type": "boolean"
    },
    "size": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 4
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}